# Configuração do MongoDB
MONGO_URI=mongodb://root:example@mongodb:27017/?authSource=admin
MONGO_DATABASE=fipe

# Credenciais do MongoDB (para o container docker-compose)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# Delay entre requisições em milissegundos (padrão 1200ms)
REQUEST_DELAY_MS=1200

# Configurações de Deploy via SSH (Makefile / deploy.sh)
VPS_USER=root
VPS_HOST=123.456.78.90
VPS_PATH=/opt/fipe-scraper
